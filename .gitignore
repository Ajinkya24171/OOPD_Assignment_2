# Ignore all object files, binaries, and executables
*.o
*.a
*.so
*.dll
*.dylib
*.exe
*.out

# Ignore build directories
/build/
/bin/
/obj/
/lib/

# Ignore log files and temporary files
*.log
*.tmp
*.swp
*.swo
*.bak
*.old

# Ignore OS generated files (macOS, Windows, Linux)
.DS_Store
Thumbs.db
*.~lock.*

# Ignore compiled code and cache files
*.class
*.pyc
*.pyo
*.jar
__pycache__/

# Ignore IDE and editor specific files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Ignore coverage reports
coverage/
*.gcno
*.gcda

# Ignore package manager files
node_modules/
npm-debug.log
yarn-error.log

# Ignore archives
*.zip
*.tar.gz
*.rar
*.7z

# Ignore debug and profiler output
*.dSYM/
*.prof
*.core

